class ProgressBar:
    """Renders a real-time progress bar with transfer speed and ETA calculation."""

    def __init__(self, total_bytes, prefix="", quiet=False):
        self.total_bytes = max(1, total_bytes)
        self.prefix = prefix
        self.quiet = quiet
        self.current_bytes = 0
        self.start_time = time.monotonic()
        self.last_update = 0.0

    def update(self, bytes_added):
        """Updates byte progress and prints formatted progress bar line at controlled intervals."""
        self.current_bytes += bytes_added
        if self.quiet:
            return

        now = time.monotonic()
        # Rate-limit updates to at most once every 0.1 seconds to minimize stdout bottleneck
        if now - self.last_update < 0.1 and self.current_bytes < self.total_bytes:
            return
        self.last_update = now

        elapsed = max(0.001, now - self.start_time)
        speed = self.current_bytes / elapsed
        percent = (self.current_bytes / self.total_bytes) * 100

        remaining_bytes = max(0, self.total_bytes - self.current_bytes)
        eta_seconds = int(remaining_bytes / speed) if speed > 0 else 0

        eta_m, eta_s = divmod(eta_seconds, 60)
        eta_h, eta_m = divmod(eta_m, 60)
        eta_str = f"{eta_h:02d}:{eta_m:02d}:{eta_s:02d}" if eta_h > 0 else f"{eta_m:02d}:{eta_s:02d}"

        curr_mb = self.current_bytes / 1048576
        total_mb = self.total_bytes / 1048576
        speed_mb = speed / 1048576

        bar_length = 20
        filled_length = int(bar_length * self.current_bytes // self.total_bytes)
        bar = "█" * filled_length + "░" * (bar_length - filled_length)

        prefix_str = f"[{self.prefix}] " if self.prefix else ""
        sys.stdout.write(
            f"\r{prefix_str}[{bar}] {percent:5.1f}% | {curr_mb:.2f} MB / {total_mb:.2f} MB | {speed_mb:5.1f} MB/s | ETA: {eta_str}"
        )
        sys.stdout.flush()

    def finish(self):
        """Completes the progress bar display and moves to a new line."""
        if self.quiet:
            return
        self.update(0)
        sys.stdout.write("\n")
        sys.stdout.flush()


class Track:
    """Represents an individual track defined within a CUE sheet."""

    def __init__(self, num, track_type, disc_blocksize_ref):
        self.num = num
        self.indexes = []
        self.track_type = track_type
        self.sectors = None
        self.file_offset = None

        if disc_blocksize_ref[0] is None:
            if track_type in ('AUDIO', 'MODE1/2352', 'MODE2/2352', 'CDI/2352'):
                disc_blocksize_ref[0] = 2352
            elif track_type == 'CDG':
                disc_blocksize_ref[0] = 2448
            elif track_type == 'MODE1/2048':
                disc_blocksize_ref[0] = 2048
            elif track_type in ('MODE2/2336', 'CDI/2336'):
                disc_blocksize_ref[0] = 2336
            d(f"Locked disc blocksize to {disc_blocksize_ref[0]}")


class File:
    """Represents a BIN file referenced inside a CUE sheet."""

    def __init__(self, filename):
        self.filename = Path(filename)
        self.tracks = []
        self.size = self.filename.stat().st_size


class ZeroBinFilesException(Exception):
    """Raised when no binary files are found in the parsed CUE sheet."""
    pass


class BinFilesMissingException(Exception):
    """Raised when referenced BIN files do not exist on disk."""
    pass


def read_cue_file(cue_path):
    """Parses a CUE file and maps its tracks, files, and sector offsets."""
    files = []
    this_track = None
    this_file = None
    bin_files_missing = False
    disc_blocksize_ref = [None]

    cue_path = Path(cue_path)
    with cue_path.open('r', encoding='utf-8', errors='replace') as f:
        for line in f:
            m = FILE_RE.search(line)
            if m:
                this_path = cue_path.parent / m.group(1)
                if not this_path.is_file():
                    e(f"Bin file not found or not readable: {this_path}")
                    bin_files_missing = True
                else:
                    this_file = File(this_path)
                    files.append(this_file)
                continue

            m = TRACK_RE.search(line)
            if m and this_file:
                this_track = Track(int(m.group(1)), m.group(2), disc_blocksize_ref)
                this_file.tracks.append(this_track)
                continue

            m = INDEX_RE.search(line)
            if m and this_track:
                this_track.indexes.append({
                    'id': int(m.group(1)),
                    'stamp': m.group(2),
                    'file_offset': cuestamp_to_sectors(m.group(2))
                })
                continue

    if bin_files_missing:
        raise BinFilesMissingException

    if not files:
        raise ZeroBinFilesException

    global_blocksize = disc_blocksize_ref[0] or 2352

    if len(files) == 1:
        next_item_offset = files[0].size // global_blocksize
        for t in reversed(files[0].tracks):
            t.sectors = next_item_offset - t.indexes[0]["file_offset"]
            next_item_offset = t.indexes[0]["file_offset"]

    return files, global_blocksize


def sectors_to_cuestamp(sectors):
    """Converts sector counts into a CUE time code string (MM:SS:FF)."""
    minutes = sectors // 4500
    fields = sectors % 4500
    seconds = fields // 75
    fields = fields % 75
    return f"{minutes:02d}:{seconds:02d}:{fields:02d}"


def cuestamp_to_sectors(stamp):
    """Converts a CUE time code string (MM:SS:FF) into sector counts."""
    m = STAMP_RE.match(stamp)
    if not m:
        return 0
    minutes = int(m.group(1))
    seconds = int(m.group(2))
    fields = int(m.group(3))
    return fields + (seconds * 75) + (minutes * 60 * 75)


def track_filename(prefix, track_num, track_count):
    """Formats output filenames for individual tracks when splitting."""
    if track_count == 1:
        return f"{prefix}.bin"
    if track_count > 9:
        return f"{prefix} (Track {track_num:02d}).bin"
    return f"{prefix} (Track {track_num}).bin"


def gen_merged_cuesheet(basename, files, global_blocksize):
    """Generates a new CUE sheet string for a single merged BIN file."""
    cuesheet_lines = [f'FILE "{basename}.bin" BINARY']
    sector_pos = 0
    for f in files:
        for t in f.tracks:
            cuesheet_lines.append(f'  TRACK {t.num:02d} {t.track_type}')
            for i in t.indexes:
                cuesheet_lines.append(
                    f'    INDEX {i["id"]:02d} {sectors_to_cuestamp(sector_pos + i["file_offset"])}'
                )
        sector_pos += f.size // global_blocksize
    return "\n".join(cuesheet_lines) + "\n"


def gen_split_cuesheet(basename, merged_file):
    """Generates a CUE sheet string corresponding to multiple split track files."""
    cuesheet_lines = []
    for t in merged_file.tracks:
        track_fn = track_filename(basename, t.num, len(merged_file.tracks))
        cuesheet_lines.append(f'FILE "{track_fn}" BINARY')
        cuesheet_lines.append(f'  TRACK {t.num:02d} {t.track_type}')
        for i in t.indexes:
            sector_pos = i['file_offset'] - t.indexes[0]['file_offset']
            cuesheet_lines.append(f'    INDEX {i["id"]:02d} {sectors_to_cuestamp(sector_pos)}')
    return "\n".join(cuesheet_lines) + "\n"


def safe_preallocate(fd, total_bytes):
    """Attempts disk space pre-allocation using fallocate if supported."""
    if hasattr(os, 'posix_fallocate'):
        try:
            os.posix_fallocate(fd, 0, total_bytes)
            d(f"Pre-allocated {total_bytes} bytes with posix_fallocate")
            return
        except OSError as err:
            if err.errno in UNSUPPORTED_ERRNOS:
                d(f"posix_fallocate not supported on this filesystem: {err}")
            else:
                d(f"posix_fallocate failed: {err}")


def copy_file_range_fallback(in_fd, out_fd, count, progress, buffer_size):
    """Copies bytes from in_fd to out_fd using os.copy_file_range if supported."""
    if not hasattr(os, 'copy_file_range'):
        return False, count

    remaining = count
    while remaining > 0:
        chunk = min(remaining, buffer_size)
        try:
            copied = os.copy_file_range(in_fd, out_fd, chunk)
            if copied == 0:
                break
            remaining -= copied
            progress.update(copied)
        except OSError as err:
            if err.errno in UNSUPPORTED_ERRNOS:
                d(f"copy_file_range unsupported on current filesystem: {err}")
                return False, remaining
            raise

    return True, remaining


def sendfile_fallback(in_fd, out_fd, count, progress, buffer_size):
    """Copies bytes from in_fd to out_fd using os.sendfile if supported."""
    if not hasattr(os, 'sendfile'):
        return False, count

    remaining = count
    # Acquire current offset from in_fd for sendfile offset
    try:
        offset = os.lseek(in_fd, 0, os.SEEK_CUR)
    except OSError:
        return False, remaining

    while remaining > 0:
        chunk = min(remaining, buffer_size)
        try:
            sent = os.sendfile(out_fd, in_fd, offset, chunk)
            if sent == 0:
                break
            offset += sent
            remaining -= sent
            progress.update(sent)
        except OSError as err:
            if err.errno in UNSUPPORTED_ERRNOS:
                d(f"sendfile unsupported on current filesystem: {err}")
                # Ensure source stream file position is updated to match offset before fallback
                try:
                    os.lseek(in_fd, offset, os.SEEK_SET)
                except OSError:
                    pass
                return False, remaining
            raise

    # Sync Python file object position with lseek after sendfile completion
    try:
        os.lseek(in_fd, offset, os.SEEK_SET)
    except OSError:
        pass

    return True, remaining


def buffered_fallback(infile, outfile, count, progress, buffer, buffer_size):
    """Fallback copying using a reusable bytearray buffer."""
    remaining = count
    view = memoryview(buffer)

    while remaining > 0:
        chunk_len = min(remaining, buffer_size)
        nread = infile.readinto(view[:chunk_len])
        if not nread:
            break
        outfile.write(view[:nread])
        remaining -= nread
        progress.update(nread)

    return remaining == 0


def transfer_bytes(infile, outfile, count, progress, buffer, buffer_size, copy_state):
    """Transfers 'count' bytes from infile to outfile, using copy_file_range -> sendfile -> buffered copy."""
    in_fd = infile.fileno()
    out_fd = outfile.fileno()

    # Priority 1: copy_file_range
    if copy_state['use_copy_file_range']:
        success, remaining = copy_file_range_fallback(in_fd, out_fd, count, progress, buffer_size)
        if success and remaining == 0:
            return True
        copy_state['use_copy_file_range'] = False
        count = remaining

    # Priority 2: sendfile
    if copy_state['use_sendfile']:
        success, remaining = sendfile_fallback(in_fd, out_fd, count, progress, buffer_size)
        if success and remaining == 0:
            return True
        copy_state['use_sendfile'] = False
        count = remaining

    # Priority 3: Reusable buffered fallback
    return buffered_fallback(infile, outfile, count, progress, buffer, buffer_size)


def merge_files(merged_filename, files, buffer_size=DEFAULT_BUFFER_SIZE, force=False, quiet=False):
    """Merges multiple BIN track files into a single binary output file."""
    merged_path = Path(merged_filename)
    if merged_path.exists() and not force:
        e(f"Target merged bin path already exists: {merged_path}")
        return False

    total_bytes = sum(f.size for f in files)
    progress = ProgressBar(total_bytes, prefix="MERGE", quiet=quiet)

    # State tracking to disable unsupported transfer methods for the entire session
    copy_state = {
        'use_copy_file_range': hasattr(os, 'copy_file_range'),
        'use_sendfile': hasattr(os, 'sendfile'),
    }

    # Allocate a single reusable byte buffer for fallbacks
    buffer = bytearray(buffer_size)

    try:
        with open(merged_path, 'wb') as outfile:
            safe_preallocate(outfile.fileno(), total_bytes)

            for f in files:
                with open(f.filename, 'rb') as infile:
                    if not transfer_bytes(
                        infile, outfile, f.size, progress, buffer, buffer_size, copy_state
                    ):
                        e(f"Failed to copy complete data for file: {f.filename}")
                        return False
    except Exception as ex:
        e(f"Error during file merge: {ex}")
        return False

    progress.finish()
    return True


def split_files(new_basename, merged_file, outdir, global_blocksize, buffer_size=DEFAULT_BUFFER_SIZE, force=False, quiet=False):
    """Splits a single merged BIN file back into separate track BIN files."""
    outdir_path = Path(outdir)

    if not force:
        for t in merged_file.tracks:
            out_basename = track_filename(new_basename, t.num, len(merged_file.tracks))
            out_path = outdir_path / out_basename
            if out_path.exists():
                e(f"Target bin path already exists: {out_path}")
                return False

    total_tracks = len(merged_file.tracks)
    copy_state = {
        'use_copy_file_range': hasattr(os, 'copy_file_range'),
        'use_sendfile': hasattr(os, 'sendfile'),
    }
    buffer = bytearray(buffer_size)

    with open(merged_file.filename, 'rb') as infile:
        for idx, t in enumerate(merged_file.tracks, 1):
            out_basename = track_filename(new_basename, t.num, total_tracks)
            out_path = outdir_path / out_basename
            tracksize = t.sectors * global_blocksize

            p(f"Writing track {idx}/{total_tracks}: {out_basename}")
            progress = ProgressBar(tracksize, prefix=f"SPLIT {idx}/{total_tracks}", quiet=quiet)

            with open(out_path, 'wb') as outfile:
                safe_preallocate(outfile.fileno(), tracksize)
                if not transfer_bytes(
                    infile, outfile, tracksize, progress, buffer, buffer_size, copy_state
                ):
                    progress.finish()
                    e(f"Unexpected end or error writing Track {t.num}")
                    return False

            progress.finish()
    return True


def process_single_cue(cuefile, basename, outdir, is_split, force, buffer_size=DEFAULT_BUFFER_SIZE, quiet=False):
    """Handles parsing and processing (merging or splitting) for a single CUE file."""
    cuefile_path = Path(cuefile).resolve()

    if not cuefile_path.is_file():
        e(f"Cue file does not exist: {cuefile_path}")
        return False

    outdir_path = Path(outdir) if outdir else cuefile_path.parent
    if not outdir_path.exists():
        try:
            p(f"Output directory did not exist; creating: {outdir_path}")
            outdir_path.mkdir(parents=True, exist_ok=True)
        except Exception as ex:
            e(f"Could not create output directory: {ex}")
            return False

    p(f"Opening cue: {cuefile_path}")
    try:
        cue_map, global_blocksize = read_cue_file(cuefile_path)
    except BinFilesMissingException:
        e("One or more bin files were missing on disk. Aborting.")
        return False
    except ZeroBinFilesException:
        e("Unable to parse any bin files in the cuesheet. Is it empty?")
        return False
    except Exception:
        e("Error parsing cuesheet. Is it valid?")
        traceback.print_exc()
        return False

    new_cue_fn = outdir_path / f"{basename}.cue"
    if new_cue_fn.exists() and not force:
        e(f"Output cue file already exists. Quitting: {new_cue_fn}")
        return False

    if is_split:
        cuesheet = gen_split_cuesheet(basename, cue_map[0])
        p(f"Splitting {len(cue_map[0].tracks)} tracks...")
        if split_files(basename, cue_map[0], outdir_path, global_blocksize, buffer_size, force, quiet):
            p(f"Wrote {len(cue_map[0].tracks)} bin files")
        else:
            e("Unable to split bin files.")
            return False
    else:
        cuesheet = gen_merged_cuesheet(basename, cue_map, global_blocksize)
        p(f"Merging {len(cue_map)} tracks...")
        out_path = outdir_path / f"{basename}.bin"
        if merge_files(out_path, cue_map, buffer_size, force, quiet):
            p(f"Wrote {out_path}")
        else:
            e("Unable to merge bin files.")
            return False

    with open(new_cue_fn, 'w', newline='\r\n', encoding='utf-8') as f:
        f.write(cuesheet)
    p(f"Wrote new cue: {new_cue_fn}")

    return True


def auto_select_cue():
    """Finds CUE files in current working directory and prompts user if multiple exist."""
    cues = sorted(list(Path('.').glob("*.cue")))
    if not cues:
        e("No .cue file found in the current directory.")
        sys.exit(1)
    if len(cues) == 1:
        p(f"Auto-detected CUE file: {cues[0].name}")
        return cues[0]

    p("Multiple .cue files found:")
    for idx, c in enumerate(cues, 1):
        print(f"  [{idx}] {c.name}")
    try:
        choice = int(input("Select CUE file number: ")) - 1
        if 0 <= choice < len(cues):
            return cues[choice]
    except (ValueError, KeyboardInterrupt):
        pass
    e("Invalid selection.")
    sys.exit(1)


def run_benchmark(tmp_dir, buffer_bytes):
    """Runs a quick performance benchmark comparing available I/O backends."""
    import tempfile

    p("Running storage backend benchmark...")
    test_size = 64 * 1024 * 1024  # 64 MiB test file
    dummy_data = os.urandom(1024 * 1024)

    bench_dir = Path(tmp_dir) if tmp_dir else Path(tempfile.gettempdir())
    src_file = bench_dir / "_binmerge_bench_src.tmp"
    dst_file = bench_dir / "_binmerge_bench_dst.tmp"

    try:
        with open(src_file, "wb") as f:
            for _ in range(64):
                f.write(dummy_data)

        results = []

        # Test copy_file_range
        if hasattr(os, 'copy_file_range'):
            try:
                t0 = time.monotonic()
                with open(src_file, 'rb') as inf, open(dst_file, 'wb') as outf:
                    rem = test_size
                    while rem > 0:
                        c = os.copy_file_range(inf.fileno(), outf.fileno(), min(rem, buffer_bytes))
                        if c == 0:
                            break
                        rem -= c
                t1 = time.monotonic()
                if rem == 0:
                    results.append(("copy_file_range", (test_size / (1024 * 1024)) / (t1 - t0)))
            except Exception as ex:
                d(f"copy_file_range benchmark skipped: {ex}")

        # Test sendfile
        if hasattr(os, 'sendfile'):
            try:
                t0 = time.monotonic()
                with open(src_file, 'rb') as inf, open(dst_file, 'wb') as outf:
                    rem = test_size
                    off = 0
                    while rem > 0:
                        c = os.sendfile(outf.fileno(), inf.fileno(), off, min(rem, buffer_bytes))
                        if c == 0:
                            break
                        off += c
                        rem -= c
                t1 = time.monotonic()
                if rem == 0:
                    results.append(("sendfile", (test_size / (1024 * 1024)) / (t1 - t0)))
            except Exception as ex:
                d(f"sendfile benchmark skipped: {ex}")

        # Test buffered readinto
        try:
            buf = bytearray(buffer_bytes)
            view = memoryview(buf)
            t0 = time.monotonic()
            with open(src_file, 'rb') as inf, open(dst_file, 'wb') as outf:
                while True:
                    n = inf.readinto(view)
                    if not n:
                        break
                    outf.write(view[:n])
            t1 = time.monotonic()
            results.append(("buffered readinto", (test_size / (1024 * 1024)) / (t1 - t0)))
        except Exception as ex:
            d(f"buffered readinto benchmark failed: {ex}")

        p("Benchmark Results (64 MB test):")
        for method, speed in results:
            print(f"  - {method:20s}: {speed:6.2f} MB/s")

    finally:
        for pth in (src_file, dst_file):
            if pth.exists():
                try:
                    pth.unlink()
                except OSError:
                    pass


def main():
    """Parses CLI arguments, handles auto-detection, and executes processing."""
    parser = argparse.ArgumentParser(
        description="Merges or splits BIN/CUE files with optimized I/O operations."
    )
    parser.add_argument('cuefile', nargs='?', help='Path to cue file (or directory if using --batch).')
    parser.add_argument('basename', nargs='?', help='Base name for generated output files.')

    class LicenseAction(argparse._StoreTrueAction):

        def __call__(self, parser, namespace, values, option_string=None):
            print_license()
            parser.exit()

    parser.add_argument('-l', '--license', default=False, help='Prints license info and exits', action=LicenseAction)
    parser.add_argument('-v', '--verbose', action='store_true', help='Print debug messages')
    parser.add_argument('-q', '--quiet', action='store_true', help='Suppress progress bar updates')
    parser.add_argument('-s', '--split', action='store_true', help='Splits a merged BIN file back into individual tracks')
    parser.add_argument('-o', '--outdir', default=None, help='Output directory (defaults to CUE directory)')
    parser.add_argument('-f', '--force', action='store_true', help='Overwrite existing output files')
    parser.add_argument('--batch', help='Process all .cue files in the specified directory sequentially')
    parser.add_argument('--buffer-mb', type=int, default=4, help='Set I/O buffer size in MiB (default: 4 MiB)')
    parser.add_argument('--benchmark', action='store_true', help='Run storage I/O backend speed benchmark and exit')

    args = parser.parse_args()

    if args.verbose:
        global VERBOSE
        VERBOSE = True

    buffer_bytes = max(1, args.buffer_mb) * 1024 * 1024

    if args.benchmark:
        run_benchmark(args.outdir, buffer_bytes)
        return True

    if args.batch:
        batch_dir = Path(args.batch).resolve()
        if not batch_dir.is_dir():
            e(f"Batch path is not a valid directory: {batch_dir}")
            return False

        cue_files = sorted(list(batch_dir.glob("*.cue")))
        if not cue_files:
            e(f"No .cue files found in {batch_dir}")
            return False

        p(f"Found {len(cue_files)} CUE files for batch processing.")
        for idx, cue_path in enumerate(cue_files, 1):
            base_name = cue_path.stem + "_merged"
            p(f"\n[{idx}/{len(cue_files)}] Processing batch item: {cue_path.name}")
            process_single_cue(
                cue_path,
                base_name,
                args.outdir,
                args.split,
                args.force,
                buffer_size=buffer_bytes,
                quiet=args.quiet
            )
        return True

    # Auto-detection if positional arguments are missing
    cuefile = args.cuefile
    basename = args.basename

    if not cuefile:
        selected_cue = auto_select_cue()
        cuefile = str(selected_cue)
        if not basename:
            basename = selected_cue.stem + "_merged"
    elif not basename:
        basename = Path(cuefile).stem + "_merged"

    return process_single_cue(
        cuefile,
        basename,
        args.outdir,
        args.split,
        args.force,
        buffer_size=buffer_bytes,
        quiet=args.quiet
    )


if __name__ == '__main__':
    if not main():
        sys.exit(1)
