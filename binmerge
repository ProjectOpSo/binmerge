VERBOSE = False
VERSION_STRING = "1.1.0-opt"
DEFAULT_BUFFER_SIZE = 4 * 1024 * 1024  # 4 MiB buffer: highly efficient and memory safe for mobile devices

# Pre-compiled regular expressions for cue sheet parsing
FILE_RE = re.compile(r'FILE\s+"?(.*?)"?\s+BINARY', re.IGNORECASE)
TRACK_RE = re.compile(r'TRACK\s+(\d+)\s+([^\s]+)', re.IGNORECASE)
INDEX_RE = re.compile(r'INDEX\s+(\d+)\s+(\d+:\d+:\d+)', re.IGNORECASE)
STAMP_RE = re.compile(r'(\d+):(\d+):(\d+)')

# Common system error codes representing unsupported kernel or filesystem operations
UNSUPPORTED_ERRNOS = {
    errno.ENOSYS,      # Function not implemented
    errno.EINVAL,      # Invalid argument (e.g. alignment or filesystem unsupported)
    errno.EXDEV,       # Cross-device link / unsupported cross-fs call
    errno.EOPNOTSUPP,  # Operation not supported
    errno.ENOTSUP,     # Operation not supported on socket/fs
    errno.EPERM,       # Operation not permitted (restricted sandbox or FUSE layer)
    errno.EACCES,      # Permission denied
}


