def d(s):
    if VERBOSE:
        print(f"[DEBUG]\t{s}")


def e(s):
    print(f"[ERROR]\t{s}")


def p(s):
    print(f"[INFO]\t{s}")


class ProgressBar:

    def __init__(self, total_bytes, prefix=""):
        self.total_bytes = max(1, total_bytes)
        self.prefix = prefix
        self.current_bytes = 0
        self.start_time = time.time()
        self.last_update = 0

    def update(self, bytes_added):
        self.current_bytes += bytes_added
        now = time.time()
        # Cap display updates to 10 times per second to minimize terminal overhead
        if now - self.last_update < 0.1 and self.current_bytes < self.total_bytes:
            return
        self.last_update = now

        elapsed = max(0.001, now - self.start_time)
        speed = self.current_bytes / elapsed
        percent = (self.current_bytes / self.total_bytes) * 100

        remaining_bytes = max(0, self.total_bytes - self.current_bytes)
        eta_seconds = int(remaining_bytes / speed) if speed > 0 else 0

        eta_m, eta_s = divmod(eta_seconds, 60)
        eta_h, eta_m = divmod(eta_m, 60)
        eta_str = f"{eta_h:02d}:{eta_m:02d}:{eta_s:02d}" if eta_h > 0 else f"{eta_m:02d}:{eta_s:02d}"

        curr_mb = self.current_bytes / (1024 * 1024)
        total_mb = self.total_bytes / (1024 * 1024)
        speed_mb = speed / (1024 * 1024)

        bar_length = 20
        filled_length = int(bar_length * self.current_bytes // self.total_bytes)
        bar = "█" * filled_length + "░" * (bar_length - filled_length)

        prefix_str = f"[{self.prefix}] " if self.prefix else ""
        sys.stdout.write(
            f"\r{prefix_str}[{bar}] {percent:5.1f}% | {curr_mb:.2f} MB / {total_mb:.2f} MB | {speed_mb:5.1f} MB/s | ETA: {eta_str}"
        )
        sys.stdout.flush()

    def finish(self):
        self.update(0)
        sys.stdout.write("\n")
        sys.stdout.flush()


class Track:

    def __init__(self, num, track_type, disc_blocksize_ref):
        self.num = num
        self.indexes = []
        self.track_type = track_type
        self.sectors = None
        self.file_offset = None

        # Lock the global blocksize per disc processing context
        if disc_blocksize_ref[0] is None:
            if track_type in ['AUDIO', 'MODE1/2352', 'MODE2/2352', 'CDI/2352']:
                disc_blocksize_ref[0] = 2352
            elif track_type == 'CDG':
                disc_blocksize_ref[0] = 2448
            elif track_type == 'MODE1/2048':
                disc_blocksize_ref[0] = 2048
            elif track_type in ['MODE2/2336', 'CDI/2336']:
                disc_blocksize_ref[0] = 2336
            d(f"Locked disc blocksize to {disc_blocksize_ref[0]}")


class File:

    def __init__(self, filename):
        self.filename = Path(filename)
        self.tracks = []
        self.size = self.filename.stat().st_size


class ZeroBinFilesException(Exception):
    pass


class BinFilesMissingException(Exception):
    pass


def read_cue_file(cue_path):
    files = []
    this_track = None
    this_file = None
    bin_files_missing = False
    disc_blocksize_ref = [None]  # Encapsulated blocksize context per disc

    cue_path = Path(cue_path)
    with cue_path.open('r', encoding='utf-8', errors='replace') as f:
        for line in f:
            m = FILE_RE.search(line)
            if m:
                this_path = cue_path.parent / m.group(1)
                if not this_path.is_file():
                    e(f"Bin file not found or not readable: {this_path}")
                    bin_files_missing = True
                else:
                    this_file = File(this_path)
                    files.append(this_file)
                continue

            m = TRACK_RE.search(line)
            if m and this_file:
                this_track = Track(int(m.group(1)), m.group(2), disc_blocksize_ref)
                this_file.tracks.append(this_track)
                continue

            m = INDEX_RE.search(line)
            if m and this_track:
                this_track.indexes.append({
                    'id': int(m.group(1)),
                    'stamp': m.group(2),
                    'file_offset': cuestamp_to_sectors(m.group(2))
                })
                continue

    if bin_files_missing:
        raise BinFilesMissingException

    if not files:
        raise ZeroBinFilesException

    global_blocksize = disc_blocksize_ref[0] or 2352

    if len(files) == 1:
        # Enforce integer division for sector offsets
        next_item_offset = files[0].size // global_blocksize
        for t in reversed(files[0].tracks):
            t.sectors = next_item_offset - t.indexes[0]["file_offset"]
            next_item_offset = t.indexes[0]["file_offset"]

    for f in files:
        d("-- File --")
        d(f"Filename: {f.filename}")
        d(f"Size: {f.size}")
        d("Tracks:")
        for t in f.tracks:
            d("  -- Track --")
            d(f"  Num: {t.num}")
            d(f"  Type: {t.track_type}")
            if t.sectors:
                d(f"  Sectors: {t.sectors}")
            d(f"  Indexes: {t.indexes}")

    return files, global_blocksize


def sectors_to_cuestamp(sectors):
    minutes = sectors // 4500
    fields = sectors % 4500
    seconds = fields // 75
    fields = fields % 75
    return f"{minutes:02d}:{seconds:02d}:{fields:02d}"


def cuestamp_to_sectors(stamp):
    m = STAMP_RE.match(stamp)
    if not m:
        return 0
    minutes = int(m.group(1))
    seconds = int(m.group(2))
    fields = int(m.group(3))
    return fields + (seconds * 75) + (minutes * 60 * 75)


def track_filename(prefix, track_num, track_count):
    if track_count == 1:
        return f"{prefix}.bin"
    if track_count > 9:
        return f"{prefix} (Track {track_num:02d}).bin"
    return f"{prefix} (Track {track_num}).bin"


def gen_merged_cuesheet(basename, files, global_blocksize):
    cuesheet = f'FILE "{basename}.bin" BINARY\n'
    sector_pos = 0
    for f in files:
        for t in f.tracks:
            cuesheet += f'  TRACK {t.num:02d} {t.track_type}\n'
            for i in t.indexes:
                cuesheet += f'    INDEX {i["id"]:02d} {sectors_to_cuestamp(sector_pos + i["file_offset"])}\n'
        # Integer division for sector position updates
        sector_pos += f.size // global_blocksize
    return cuesheet


def gen_split_cuesheet(basename, merged_file):
    cuesheet = ""
    for t in merged_file.tracks:
        track_fn = track_filename(basename, t.num, len(merged_file.tracks))
        cuesheet += f'FILE "{track_fn}" BINARY\n'
        cuesheet += f'  TRACK {t.num:02d} {t.track_type}\n'
        for i in t.indexes:
            sector_pos = i['file_offset'] - t.indexes[0]['file_offset']
            cuesheet += f'    INDEX {i["id"]:02d} {sectors_to_cuestamp(sector_pos)}\n'
    return cuesheet


def merge_files(merged_filename, files, buffer_size=DEFAULT_BUFFER_SIZE, force=False):
    merged_path = Path(merged_filename)
    if merged_path.exists() and not force:
        e(f"Target merged bin path already exists: {merged_path}")
        return False

    total_bytes = sum(f.size for f in files)
    progress = ProgressBar(total_bytes, prefix="MERGE")

    try:
        with open(merged_path, 'wb') as outfile:
            out_fd = outfile.fileno()

            for f in files:
                with open(f.filename, 'rb') as infile:
                    in_fd = infile.fileno()
                    remaining = f.size

                    # Fast-path attempt using kernel sendfile zero-copy
                    use_sendfile = hasattr(os, 'sendfile')
                    if use_sendfile:
                        offset = 0
                        while remaining > 0:
                            chunk_to_send = min(remaining, buffer_size)
                            try:
                                sent = os.sendfile(out_fd, in_fd, offset, chunk_to_send)
                                if sent == 0:
                                    break
                                offset += sent
                                remaining -= sent
                                progress.update(sent)
                            except (OSError, AttributeError) as err:
                                d(f"sendfile unavailable or failed ({err}), falling back to standard read/write")
                                use_sendfile = False
                                break

                    # Standard buffered fallback loop
                    if not use_sendfile:
                        while True:
                            chunk = infile.read(buffer_size)
                            if not chunk:
                                break
                            outfile.write(chunk)
                            progress.update(len(chunk))
    except Exception as ex:
        e(f"Error during file merge: {ex}")
        return False

    progress.finish()
    return True


def split_files(new_basename, merged_file, outdir, global_blocksize, buffer_size=DEFAULT_BUFFER_SIZE, force=False):
    outdir_path = Path(outdir)

    # Check target files first to prevent accidental clobbering
    if not force:
        for t in merged_file.tracks:
            out_basename = track_filename(new_basename, t.num, len(merged_file.tracks))
            out_path = outdir_path / out_basename
            if out_path.exists():
                e(f"Target bin path already exists: {out_path}")
                return False

    total_tracks = len(merged_file.tracks)
    with open(merged_file.filename, 'rb') as infile:
        for idx, t in enumerate(merged_file.tracks, 1):
            out_basename = track_filename(new_basename, t.num, total_tracks)
            out_path = outdir_path / out_basename
            tracksize = t.sectors * global_blocksize

            p(f"Writing track {idx}/{total_tracks}: {out_basename}")
            progress = ProgressBar(tracksize, prefix=f"SPLIT {idx}/{total_tracks}")
            written = 0

            with open(out_path, 'wb') as outfile:
                while written < tracksize:
                    to_read = min(buffer_size, tracksize - written)
                    chunk = infile.read(to_read)

                    if not chunk:
                        progress.finish()
                        raise IOError(f"Unexpected end of merged BIN file while processing Track {t.num}")

                    outfile.write(chunk)
                    chunk_len = len(chunk)
                    written += chunk_len
                    progress.update(chunk_len)

            progress.finish()
    return True


def process_single_cue(cuefile, basename, outdir, is_split, force, buffer_size=DEFAULT_BUFFER_SIZE):
    cuefile_path = Path(cuefile).resolve()

    if not cuefile_path.is_file():
        e(f"Cue file does not exist: {cuefile_path}")
        return False

    outdir_path = Path(outdir) if outdir else cuefile_path.parent
    if not outdir_path.exists():
        try:
            p(f"Output directory did not exist; creating: {outdir_path}")
            outdir_path.mkdir(parents=True, exist_ok=True)
        except Exception as ex:
            e(f"Could not create output directory: {ex}")
            return False

    p(f"Opening cue: {cuefile_path}")
    try:
        cue_map, global_blocksize = read_cue_file(cuefile_path)
    except BinFilesMissingException:
        e("One or more bin files were missing on disk. Aborting.")
        return False
    except ZeroBinFilesException:
        e("Unable to parse any bin files in the cuesheet. Is it empty?")
        return False
    except Exception:
        e("Error parsing cuesheet. Is it valid?")
        traceback.print_exc()
        return False

    new_cue_fn = outdir_path / f"{basename}.cue"
    if new_cue_fn.exists() and not force:
        e(f"Output cue file already exists. Quitting: {new_cue_fn}")
        return False

    if is_split:
        cuesheet = gen_split_cuesheet(basename, cue_map[0])
        p(f"Splitting {len(cue_map[0].tracks)} tracks...")
        if split_files(basename, cue_map[0], outdir_path, global_blocksize, buffer_size, force=force):
            p(f"Wrote {len(cue_map[0].tracks)} bin files")
        else:
            e("Unable to split bin files.")
            return False
    else:
        cuesheet = gen_merged_cuesheet(basename, cue_map, global_blocksize)
        p(f"Merging {len(cue_map)} tracks...")
        out_path = outdir_path / f"{basename}.bin"
        if merge_files(out_path, cue_map, buffer_size=buffer_size, force=force):
            p(f"Wrote {out_path}")
        else:
            e("Unable to merge bin files.")
            return False

    with open(new_cue_fn, 'w', newline='\r\n', encoding='utf-8') as f:
        f.write(cuesheet)
    p(f"Wrote new cue: {new_cue_fn}")

    return True


def main():
    parser = argparse.ArgumentParser(
        description="Merges or splits BIN/CUE files with optimized I/O operations."
    )
    parser.add_argument('cuefile', nargs='?', help='Path to cue file (or directory if using --batch).')
    parser.add_argument('basename', nargs='?', help='Base name for generated output files.')

    class LicenseAction(argparse._StoreTrueAction):

        def __call__(self, parser, namespace, values, option_string=None):
            print_license()
            parser.exit()

    parser.add_argument('-l', '--license', default=False, help='Prints license info and exits', action=LicenseAction)
    parser.add_argument('-v', '--verbose', action='store_true', help='Print debug messages')
    parser.add_argument('-s', '--split', action='store_true', help='Splits a merged BIN file back into individual tracks')
    parser.add_argument('-o', '--outdir', default=None, help='Output directory (defaults to CUE directory)')
    parser.add_argument('-f', '--force', action='store_true', help='Overwrite existing output files')
    parser.add_argument('--batch', help='Process all .cue files in the specified directory sequentially')
    parser.add_argument('--buffer-mb', type=int, default=16, help='Set I/O buffer size in MiB (default: 16 MiB)')

    args = parser.parse_args()

    if args.verbose:
        global VERBOSE
        VERBOSE = True

    buffer_bytes = max(1, args.buffer_mb) * 1024 * 1024

    # Batch processing execution path
    if args.batch:
        batch_dir = Path(args.batch).resolve()
        if not batch_dir.is_dir():
            e(f"Batch path is not a valid directory: {batch_dir}")
            return False

        cue_files = sorted(list(batch_dir.glob("*.cue")))
        if not cue_files:
            e(f"No .cue files found in {batch_dir}")
            return False

        p(f"Found {len(cue_files)} CUE files for batch processing.")
        for idx, cue_path in enumerate(cue_files, 1):
            base_name = cue_path.stem + "_merged"
            p(f"\n[{idx}/{len(cue_files)}] Processing batch item: {cue_path.name}")
            process_single_cue(
                cue_path,
                base_name,
                args.outdir,
                args.split,
                args.force,
                buffer_size=buffer_bytes
            )
        return True

    # Single-file processing execution path
    if not args.cuefile or not args.basename:
        parser.error("cuefile and basename are required unless using --batch.")

    return process_single_cue(
        args.cuefile,
        args.basename,
        args.outdir,
        args.split,
        args.force,
        buffer_size=buffer_bytes
    )


if __name__ == '__main__':
    if not main():
        sys.exit(1)
