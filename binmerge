from pathlib import Path

VERBOSE = False
VERSION_STRING = "1.1.0"
DEFAULT_BUFFER_SIZE = 16 * 1024 * 1024  # 16 MiB Buffer

# Pre-compiled regular expressions for cue sheet parsing
FILE_RE = re.compile(r'FILE\s+"?(.*?)"?\s+BINARY', re.IGNORECASE)
TRACK_RE = re.compile(r'TRACK\s+(\d+)\s+([^\s]+)', re.IGNORECASE)
INDEX_RE = re.compile(r'INDEX\s+(\d+)\s+(\d+:\d+:\d+)', re.IGNORECASE)
STAMP_RE = re.compile(r'(\d+):(\d+):(\d+)')


